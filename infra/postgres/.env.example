# NOXUND — local PostgreSQL config (NON-SECRET). Copy to `.env` (gitignored) if
# you want to override defaults. PASSWORDS DO NOT LIVE HERE — they are Docker
# Compose secrets under ./.local-secrets/ created by scripts/prepare-local.
#
# This file contains ONLY names + placeholders. Never put a real password here.

# Compose project scope (default; CI may override to isolate runs).
COMPOSE_PROJECT_NAME=noxund-local

# Where the loopback-only server is published (for your host psql client).
# The authoritative binding is in compose.local.yml (127.0.0.1:5433).
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=noxund

# Example LOCAL app connection string (NO password inline — psql/libpq reads the
# password from ~/.pgpass or an interactive prompt; NEVER commit a real value).
# DATABASE_URL=postgresql://noxund_app@127.0.0.1:5433/noxund?sslmode=disable

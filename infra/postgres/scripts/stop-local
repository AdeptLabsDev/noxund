#!/usr/bin/env bash
# =============================================================================
# stop-local — tear down the container/network but PRESERVE the data volume.
# NEVER passes -v. Idempotent.
# =============================================================================
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
assert_local_docker

vol="$(volume_name)"
info "stopping service '${SERVICE}' (project ${COMPOSE_PROJECT_NAME}); volume '${vol:-<none>}' will be PRESERVED."
dc down --remove-orphans   # no -v => named volume kept
info "stopped. Volume preserved: ${vol:-<none>}."
